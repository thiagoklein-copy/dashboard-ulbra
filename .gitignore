# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planilhas de matrícula
#
# A base do sistema acadêmico traz nome do aluno e número de contrato. Só o
# agregado sem PII vai para o banco, via `npm run importar-matriculas` — o
# arquivo em si nunca entra no repositório.
*.xlsx
*.xls
*.csv

# carga de matrículas gerada por `--sql` (regenerável, muda todo dia)
carga-matriculas*.sql
