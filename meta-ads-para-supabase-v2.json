{
  "name": "Meta Ads → Supabase (ULBRA) v2",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "trigger-diario",
      "name": "Trigger Diário (06h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -260,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/act_{{$env.META_AD_ACCOUNT_ID}}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "level",
              "value": "ad"
            },
            {
              "name": "date_preset",
              "value": "yesterday"
            },
            {
              "name": "time_increment",
              "value": "1"
            },
            {
              "name": "limit",
              "value": "500"
            },
            {
              "name": "fields",
              "value": "ad_id,ad_name,adset_id,adset_name,campaign_id,campaign_name,spend,impressions,clicks,ctr,cpc,cpm,objective,results,cost_per_result,actions,date_start,date_stop,video_play_actions,video_avg_time_watched_actions,video_p25_watched_actions,video_p50_watched_actions,video_p75_watched_actions,video_p95_watched_actions,video_p100_watched_actions"
            },
            {
              "name": "access_token",
              "value": "={{$env.META_ACCESS_TOKEN}}"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{ $response.body.paging?.next }}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging?.next }}",
              "limitPagesFetched": true,
              "maxRequests": 100
            }
          },
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "http-insights",
      "name": "Buscar Insights (Meta API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        140
      ],
      "onError": "stopWorkflow",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-insights",
