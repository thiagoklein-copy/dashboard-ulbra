              "value": "={{$json.date_stop}}",
              "type": "string"
            },
            {
              "name": "spend",
              "value": "={{ Number($json.spend ?? 0) }}",
              "type": "number"
            },
            {
              "name": "impressions",
              "value": "={{ Number($json.impressions ?? 0) }}",
              "type": "number"
            },
            {
              "name": "clicks",
              "value": "={{ Number($json.clicks ?? 0) }}",
              "type": "number"
            },
            {
              "name": "ctr",
              "value": "={{ Number($json.ctr ?? 0) }}",
              "type": "number"
            },
            {
              "name": "cpc",
              "value": "={{ $json.cpc == null ? null : Number($json.cpc) }}",
              "type": "number"
            },
            {
              "name": "cpm",
              "value": "={{ Number($json.cpm ?? 0) }}",
              "type": "number"
            },
            {
              "name": "objective",
              "value": "={{ $json.objective ?? null }}",
              "type": "string"
            },
            {
              "name": "result_indicator",
              "value": "={{ $json.results?.[0]?.indicator ?? null }}",
              "type": "string"
            },
            {
              "name": "results",
              "value": "={{ Number($json.results?.[0]?.values?.[0]?.value ?? 0) }}",
              "type": "number"
            },
            {
              "name": "cost_per_result",
              "value": "={{ $json.cost_per_result?.[0]?.values?.[0]?.value == null ? null : Number($json.cost_per_result[0].values[0].value) }}",
              "type": "number"
            },
            {
              "name": "raw_actions",
              "value": "={{ JSON.stringify($json.actions ?? []) }}",
              "type": "string"
            },
            {
              "name": "video_plays",
              "value": "={{ Number($json.video_play_actions?.[0]?.value ?? 0) || null }}",
              "type": "number"
            },
            {
              "name": "video_avg_watch_time_sec",
              "value": "={{ Number($json.video_avg_time_watched_actions?.[0]?.value ?? 0) || null }}",
              "type": "number"
            },
            {
              "name": "video_p25",
              "value": "={{ (() => { const p = Number($json.video_play_actions?.[0]?.value ?? 0); const w = Number($json.video_p25_watched_actions?.[0]?.value ?? 0); return p ? Math.round(w / p * 10000) / 100 : null; })() }}",
              "type": "number"
            },
            {
              "name": "video_p50",
              "value": "={{ (() => { const p = Number($json.video_play_actions?.[0]?.value ?? 0); const w = Number($json.video_p50_watched_actions?.[0]?.value ?? 0); return p ? Math.round(w / p * 10000) / 100 : null; })() }}",
              "type": "number"
            },
            {
              "name": "video_p75",
              "value": "={{ (() => { const p = Number($json.video_play_actions?.[0]?.value ?? 0); const w = Number($json.video_p75_watched_actions?.[0]?.value ?? 0); return p ? Math.round(w / p * 10000) / 100 : null; })() }}",
              "type": "number"
            },
            {
              "name": "video_p95",
              "value": "={{ (() => { const p = Number($json.video_play_actions?.[0]?.value ?? 0); const w = Number($json.video_p95_watched_actions?.[0]?.value ?? 0); return p ? Math.round(w / p * 10000) / 100 : null; })() }}",
              "type": "number"
            },
            {
              "name": "video_p100",
              "value": "={{ (() => { const p = Number($json.video_play_actions?.[0]?.value ?? 0); const w = Number($json.video_p100_watched_actions?.[0]?.value ?? 0); return p ? Math.round(w / p * 10000) / 100 : null; })() }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
