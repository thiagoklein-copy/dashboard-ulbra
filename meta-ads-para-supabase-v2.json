    {
      "parameters": {
        "jsCode": "const ids = [...new Set($input.all().map(i => i.json.ad_id).filter(Boolean))];\nconst out = [];\nfor (let i = 0; i < ids.length; i += 50) {\n  const lote = ids.slice(i, i + 50);\n  out.push({ json: {\n    filtro: JSON.stringify([{ field: 'id', operator: 'IN', value: lote }]),\n    qtd: lote.length,\n  }});\n}\nreturn out;"
      },
