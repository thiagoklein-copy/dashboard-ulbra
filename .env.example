NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
DASHBOARD_PASSWORD=altere-esta-senha

# Chave que assina o cookie de sessão. Opcional: sem ela a assinatura usa a
# própria senha, e trocar a senha derruba todas as sessões abertas — que é o
# comportamento desejado. Defina se quiser separar as duas coisas.
# AUTH_SECRET=

# `true` liga a base falsa de `lib/mock-data.ts`, para desenvolver sem
# Supabase. Qualquer outro valor (ou ausente) lê o banco de verdade: o
# padrão erra para o lado de "sem dados", nunca para o de dados inventados.
USE_MOCK_DATA=false

# Escrita de matrículas (`npm run importar-matriculas`).
#
# Vai num arquivo à parte, `.env.import`, e NÃO aqui: a service_role ignora
# o RLS e não deve circular junto com a chave anônima que vai para o
# navegador. O dashboard só lê, e para ler a anon key basta.
#
#   .env.import
#   SUPABASE_URL=https://seu-projeto.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=sua-service-role-aqui
