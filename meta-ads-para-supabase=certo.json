{
  "name": "Meta Ads → Supabase (ULBRA)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6
            }
          ]
        }
      },
      "id": "trigger-diario",
      "name": "Trigger Diário (06h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/act_{{$env.META_AD_ACCOUNT_ID}}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "level", "value": "ad" },
            { "name": "date_preset", "value": "yesterday" },
            { "name": "time_increment", "value": "1" },
            {
              "name": "fields",
              "value": "ad_id,ad_name,adset_id,adset_name,campaign_id,campaign_name,spend,impressions,clicks,ctr,cpc,cpm,actions,cost_per_action_type,date_start,date_stop"
            },
            { "name": "access_token", "value": "={{$env.META_ACCESS_TOKEN}}" }
          ]
        },
        "options": {}
      },
      "id": "http-insights",
      "name": "Buscar Insights (Meta API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 160]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-insights",
      "name": "Separar Cada Ad",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [260, 160]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "ad_id", "value": "={{$json.ad_id}}", "type": "string" },
            { "name": "ad_name", "value": "={{$json.ad_name}}", "type": "string" },
            { "name": "adset_id", "value": "={{$json.adset_id}}", "type": "string" },
            { "name": "adset_name", "value": "={{$json.adset_name}}", "type": "string" },
            { "name": "campaign_id", "value": "={{$json.campaign_id}}", "type": "string" },
            { "name": "campaign_name", "value": "={{$json.campaign_name}}", "type": "string" },
            { "name": "date_start", "value": "={{$json.date_start}}", "type": "string" },
            { "name": "date_stop", "value": "={{$json.date_stop}}", "type": "string" },
            { "name": "spend", "value": "={{$json.spend}}", "type": "number" },
            { "name": "impressions", "value": "={{$json.impressions}}", "type": "number" },
            { "name": "clicks", "value": "={{$json.clicks}}", "type": "number" },
            { "name": "ctr", "value": "={{$json.ctr}}", "type": "number" },
            { "name": "cpc", "value": "={{$json.cpc}}", "type": "number" },
            { "name": "cpm", "value": "={{$json.cpm}}", "type": "number" },
            { "name": "raw_actions", "value": "={{JSON.stringify($json.actions)}}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "mapear-insights",
      "name": "Mapear Campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{$env.SUPABASE_PROJECT_REF}}.supabase.co/rest/v1/ad_insights?on_conflict=ad_id,date_start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "supabase-insights",
      "name": "Salvar em ad_insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 160]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/act_{{$env.META_AD_ACCOUNT_ID}}/ads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,campaign{name},creative{title,body,object_story_spec,image_url,video_id,call_to_action_type,link_url,effective_object_story_id}"
            },
            { "name": "access_token", "value": "={{$env.META_ACCESS_TOKEN}}" }
          ]
        },
        "options": {}
      },
      "id": "http-criativos",
      "name": "Buscar Criativos (Meta API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [40, 420]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-criativos",
      "name": "Separar Cada Criativo",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [260, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{$json.creative?.effective_object_story_id}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-tem-post-original",
      "name": "Tem Post Original?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 420]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{$json.creative.effective_object_story_id}}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "message,full_picture" },
            { "name": "access_token", "value": "={{$env.META_ACCESS_TOKEN}}" }
          ]
        },
        "options": {}
      },
      "id": "http-post-original",
      "name": "Buscar Post Original (Meta API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 380]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "ad_id", "value": "={{$node[\"Separar Cada Criativo\"].json.id}}", "type": "string" },
            { "name": "ad_name", "value": "={{$node[\"Separar Cada Criativo\"].json.name}}", "type": "string" },
            { "name": "campaign_name", "value": "={{$node[\"Separar Cada Criativo\"].json.campaign?.name}}", "type": "string" },
            { "name": "headline", "value": "={{$node[\"Separar Cada Criativo\"].json.creative?.title || null}}", "type": "string" },
            { "name": "primary_text", "value": "={{$json.message || $node[\"Separar Cada Criativo\"].json.creative?.body || null}}", "type": "string" },
            { "name": "call_to_action", "value": "={{$node[\"Separar Cada Criativo\"].json.creative?.call_to_action_type}}", "type": "string" },
            { "name": "image_url", "value": "={{$json.full_picture || $node[\"Separar Cada Criativo\"].json.creative?.image_url || null}}", "type": "string" },
            { "name": "video_id", "value": "={{$node[\"Separar Cada Criativo\"].json.creative?.video_id}}", "type": "string" },
            { "name": "link_url", "value": "={{$node[\"Separar Cada Criativo\"].json.creative?.link_url}}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "mapear-criativos",
      "name": "Mapear Criativos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{$env.SUPABASE_PROJECT_REF}}.supabase.co/rest/v1/ad_creatives?on_conflict=ad_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "supabase-criativos",
      "name": "Salvar em ad_creatives",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 340]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "leftValue": "={{$json.video_id}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-tem-video",
      "name": "Tem Vídeo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, 500]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{$json.video_id}}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "fields", "value": "source" },
            { "name": "access_token", "value": "={{$env.META_ACCESS_TOKEN}}" }
          ]
        },
        "options": {}
      },
      "id": "http-video-source",
      "name": "Pegar URL do Vídeo (Meta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1360, 500]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.source}}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "http-baixar-video",
      "name": "Baixar Vídeo (Binário)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1580, 500]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{$env.SUPABASE_PROJECT_REF}}.supabase.co/storage/v1/object/ad-videos/{{$node[\"Mapear Criativos\"].json.ad_id}}.mp4",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "x-upsert", "value": "true" }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "id": "http-upload-storage",
      "name": "Upload pro Supabase Storage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 420]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$env.OPENAI_API_KEY}}" }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "parameterType": "formBinaryData", "name": "file", "inputDataFieldName": "data" },
            { "parameterType": "formData", "name": "model", "value": "whisper-1" },
            { "parameterType": "formData", "name": "language", "value": "pt" }
          ]
        },
        "options": {}
      },
      "id": "http-whisper",
      "name": "Transcrever (Whisper)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, 580]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "ad_id", "value": "={{$node[\"Mapear Criativos\"].json.ad_id}}", "type": "string" },
            { "name": "video_storage_url", "value": "=https://{{$env.SUPABASE_PROJECT_REF}}.supabase.co/storage/v1/object/public/ad-videos/{{$node[\"Mapear Criativos\"].json.ad_id}}.mp4", "type": "string" },
            { "name": "video_transcript", "value": "={{$node[\"Transcrever (Whisper)\"].json.text}}", "type": "string" },
            { "name": "video_transcript_updated_at", "value": "={{$now.toISO()}}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "montar-dados-transcricao",
      "name": "Montar Dados da Transcrição",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2020, 580]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{$env.SUPABASE_PROJECT_REF}}.supabase.co/rest/v1/ad_creatives?on_conflict=ad_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "resolution=merge-duplicates" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "supabase-transcript",
      "name": "Salvar Transcrição em ad_creatives",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2240, 580]
    }
  ],
  "connections": {
    "Trigger Diário (06h)": {
      "main": [
        [
          { "node": "Buscar Insights (Meta API)", "type": "main", "index": 0 },
          { "node": "Buscar Criativos (Meta API)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Buscar Insights (Meta API)": {
      "main": [[{ "node": "Separar Cada Ad", "type": "main", "index": 0 }]]
    },
    "Separar Cada Ad": {
      "main": [[{ "node": "Mapear Campos", "type": "main", "index": 0 }]]
    },
    "Mapear Campos": {
      "main": [[{ "node": "Salvar em ad_insights", "type": "main", "index": 0 }]]
    },
    "Buscar Criativos (Meta API)": {
      "main": [[{ "node": "Separar Cada Criativo", "type": "main", "index": 0 }]]
    },
    "Separar Cada Criativo": {
      "main": [[{ "node": "Tem Post Original?", "type": "main", "index": 0 }]]
    },
    "Tem Post Original?": {
      "main": [
        [{ "node": "Buscar Post Original (Meta API)", "type": "main", "index": 0 }],
        [{ "node": "Mapear Criativos", "type": "main", "index": 0 }]
      ]
    },
    "Buscar Post Original (Meta API)": {
      "main": [[{ "node": "Mapear Criativos", "type": "main", "index": 0 }]]
    },
    "Mapear Criativos": {
      "main": [
        [
          { "node": "Salvar em ad_creatives", "type": "main", "index": 0 },
          { "node": "Tem Vídeo?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Tem Vídeo?": {
      "main": [
        [{ "node": "Pegar URL do Vídeo (Meta)", "type": "main", "index": 0 }],
        []
      ]
    },
    "Pegar URL do Vídeo (Meta)": {
      "main": [[{ "node": "Baixar Vídeo (Binário)", "type": "main", "index": 0 }]]
    },
    "Baixar Vídeo (Binário)": {
      "main": [
        [
          { "node": "Upload pro Supabase Storage", "type": "main", "index": 0 },
          { "node": "Transcrever (Whisper)", "type": "main", "index": 0 }
        ]
      ]
    },
    "Transcrever (Whisper)": {
      "main": [[{ "node": "Montar Dados da Transcrição", "type": "main", "index": 0 }]]
    },
    "Montar Dados da Transcrição": {
      "main": [[{ "node": "Salvar Transcrição em ad_creatives", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
