    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  for (const ad of (item.json.data || [])) out.push({ json: ad });\n}\nreturn out;"
      },
      "id": "achatar-criativos",
      "name": "Achatar Resposta",
      "type": "n8n-nodes-base.code",
